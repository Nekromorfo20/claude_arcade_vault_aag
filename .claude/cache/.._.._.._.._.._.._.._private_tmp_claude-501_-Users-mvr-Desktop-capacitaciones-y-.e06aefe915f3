import { chromium } from "playwright";
import path from "node:path";
import fs from "node:fs";

const OUT = "/private/tmp/claude-501/-Users-mvr-Desktop-capacitaciones-y-cursos-udemy-claude-code-05-arcade-vault/7141bce9-8faf-4214-a13d-e16f120155e0/scratchpad/shots";
fs.mkdirSync(OUT, { recursive: true });

const PROTO_PATH = "http://localhost:8088/Arcade%20Vault.html";

const viewports = {
  desktop: { width: 1440, height: 900 },
  mobile: { width: 390, height: 844 },
};

const browser = await chromium.launch();

async function shotNext(routePath, name) {
  for (const [vp, size] of Object.entries(viewports)) {
    const ctx = await browser.newContext({ viewport: size });
    const page = await ctx.newPage();
    await page.goto(`http://localhost:3099${routePath}`, { waitUntil: "networkidle" });
    await page.waitForTimeout(500);
    await page.screenshot({ path: path.join(OUT, `next-${name}-${vp}.png`), fullPage: vp === "desktop" });
    await ctx.close();
  }
}

async function shotProto(routeObj, name) {
  for (const [vp, size] of Object.entries(viewports)) {
    const ctx = await browser.newContext({ viewport: size });
    const page = await ctx.newPage();
    page.on("console", (msg) => console.log(`[proto-${name}-${vp}] console:`, msg.text()));
    page.on("pageerror", (err) => console.log(`[proto-${name}-${vp}] pageerror:`, err.message));
    const hash = encodeURIComponent(JSON.stringify(routeObj));
    await page.goto(`${PROTO_PATH}#${hash}`, { waitUntil: "networkidle" });
    await page.waitForFunction(() => document.getElementById("root")?.children.length > 0, { timeout: 10000 }).catch((e) => console.log(`[proto-${name}-${vp}] root never populated:`, e.message));
    await page.waitForTimeout(800);
    await page.screenshot({ path: path.join(OUT, `proto-${name}-${vp}.png`), fullPage: vp === "desktop" });
    await ctx.close();
  }
}

// Next.js routes (already captured)

// Prototype routes (hash router)
await shotProto({ name: "biblioteca" }, "biblioteca");
await shotProto({ name: "detalle", id: "bloque-buster" }, "detalle");
await shotProto({ name: "player", id: "bloque-buster" }, "player");
await shotProto({ name: "auth" }, "auth");
await shotProto({ name: "salon" }, "salon");

await browser.close();
console.log("done");
